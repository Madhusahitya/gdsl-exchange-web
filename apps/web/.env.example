# koie.fin web app — copy to apps/web/.env.local
# Safe to commit. Never put secrets here (only NEXT_PUBLIC_* belong in the browser).

# ── API (local dev: backend on 8000; production uses api.godslandx.com / port 4000) ─
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000

# Same hostname as the browser tab (localhost vs 127.0.0.1 matters for cookies)
NEXT_PUBLIC_APP_URL=http://localhost:8003

# Optional — proxy /api through Next.js instead of calling API host directly
# NEXT_PUBLIC_USE_API_PROXY=1

# ── WalletConnect (BSC wallet UI — 50+ wallets via QR) ───────────────────────
# Create a project at https://cloud.walletconnect.com/
# Setting a project id is enough — the connector registers automatically.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
# Only needed to force WalletConnect OFF (its relay socket is noisy in dev).
# NEXT_PUBLIC_WALLETCONNECT_ENABLED=false

# ── Solana browser wallets (Phantom, Solflare, Backpack) ─────────────────────
# Used for reading connected-wallet balances and signing funding transfers.
# The public endpoint is heavily rate-limited — use Helius/QuickNode in prod.
# NEXT_PUBLIC_SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# ── Fiat on/off-ramp (optional — Transak / MoonPay publishable keys) ────────
# NEXT_PUBLIC_TRANSAK_API_KEY=
# NEXT_PUBLIC_MOONPAY_API_KEY=

# Optional — dedicated BSC RPC (more reliable than public defaults)
# NEXT_PUBLIC_BSC_RPC_URL=https://bsc-dataseed.binance.org

# ── Optional client-side safety caps (must match backend policy if enforced) ─
# NEXT_PUBLIC_MAX_TRADE_SIZE_USDT=50
# NEXT_PUBLIC_EMERGENCY_STOP_ENABLED=true

# ── Optional Telegram alert header (dev only; must match server GDSL_ALERT_SECRET)
# NEXT_PUBLIC_GDSL_ALERT_SECRET=
