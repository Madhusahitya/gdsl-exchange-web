{
  "name": "gdsl-exchange-web",
  "version": "1.0.0",
  "private": true,
  "description": "Godslandx / koie.fin trading frontend — Next.js",
  "workspaces": [
    "apps/web",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=@cryptoflow/web",
    "dev:clean": "npm run dev:clean --workspace=@cryptoflow/web",
    "build": "npm run build --workspace=@cryptoflow/dex-pancake && npm run build --workspace=@cryptoflow/web",
    "start": "npm run start --workspace=@cryptoflow/web",
    "lint": "npm run lint --workspace=@cryptoflow/web",
    "test": "npm run test --workspace=@cryptoflow/web",
    "docker:up": "docker compose up --build",
    "docker:down": "docker compose down"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "overrides": {
    "@types/react": "18.3.18",
    "@types/react-dom": "18.3.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.2.0",
    "prettier": "^3.8.2",
    "typescript-eslint": "^8.58.1"
  }
}
